-- Usuarios semilla. Los passwords en texto plano de este comentario son intencionalmente débiles y
-- forman parte del reto (ver CLAUDE.md — excepción documentada a "secretos fuera de git").
--
-- VULN: hashing MD5 sin salt + passwords de diccionario (Reto 2). Salvo jperez (ver abajo), cada password
-- fue elegida deliberadamente porque aparece entre las más comunes de rockyou.txt, para que las 5
-- restantes se crackeen con `hashcat -m 0` en segundos incluso con una wordlist básica/recortada.
INSERT INTO users (username, password_md5, role, full_name, email) VALUES
    -- admin: cuenta de administracion real de la app. Reutiliza una password de diccionario a propósito
    -- (no es un descuido): el reto de XSS usa una credencial de bot separada (ver services/xss-bot), así
    -- que crackear esta no da ningún atajo — solo refuerza la lección de hashcat en el Reto 2.
    ('admin', MD5('qwerty'), 'admin', 'Administrador Sabana Corp', 'admin@sabanacorp.lab'),

    -- jperez: credencial de Empleado filtrada en el HTML/JS del login (Reto 1, vulnerabilidad #1). Se
    -- deja fuera de la lista "crackeable con rockyou" a propósito: el participante ya la obtiene
    -- directamente vía el comentario HTML, sin necesidad de hashcat, y login.php valida contra este mismo
    -- valor literal — cambiarlo rompería el Reto 1.1.
    ('jperez', MD5('Bienvenido123'), 'employee', 'Juan Perez', 'jperez@sabanacorp.lab'),

    -- it_soporte: usuario de TI cuyo ID se descubre via SQLi (Reto 1, vulnerabilidad #2) y cuyo perfil
    -- se accede via IDOR (Reto 1, vulnerabilidad #3).
    ('it_soporte', MD5('monkey'), 'it', 'Soporte TI', 'it.soporte@sabanacorp.lab'),

    -- msilva: password reuse deliberado — su contraseña de la app es la MISMA que su contraseña SSH en
    -- el Linux Server del Reto 3 (PIVOT_SSH_PASSWORD). Este es el secreto de progresion que conecta el
    -- Reto 2 con el Reto 3. PIVOT_SSH_PASSWORD debe ser, por diseño, una password de diccionario
    -- (ver .env.example) para que este hash también sea crackeable con rockyou.
    ('msilva', MD5('${PIVOT_SSH_PASSWORD}'), 'employee', 'Maria Silva', 'msilva@sabanacorp.lab'),

    -- Empleados de "ruido" adicionales, sin rol en la cadena de explotacion.
    ('rgomez', MD5('Password1'), 'employee', 'Ricardo Gomez', 'rgomez@sabanacorp.lab'),
    ('lcastro', MD5('iloveyou'), 'employee', 'Laura Castro', 'lcastro@sabanacorp.lab');

